# RepoMind — sample environment configuration (12-factor).
# Copy to .env and fill in the secret values; never commit .env.

# ---- HTTP server ----
REPOMIND_HTTP_ADDR=:8080
REPOMIND_HTTP_READ_TIMEOUT=15s
REPOMIND_HTTP_WRITE_TIMEOUT=30s
REPOMIND_HTTP_SHUTDOWN_TIMEOUT=15s
# Shared secret for operator endpoints (Authorization: Bearer <key>).
# Must be >= 16 chars when set. When empty, the operator API surface
# (`/api/v1/*`) is NOT REGISTERED — privileged routes fail closed.
# Generate with: openssl rand -hex 32
REPOMIND_HTTP_API_KEY=

# ---- Observability ----
REPOMIND_LOG_LEVEL=info                # debug | info | warn | error
REPOMIND_LOG_FORMAT=json               # json | console
REPOMIND_OTEL_EXPORTER_OTLP_ENDPOINT=  # leave empty to disable tracing
REPOMIND_METRICS_ADDR=:9090            # Prometheus /metrics exposed here

# ---- PostgreSQL ----
REPOMIND_POSTGRES_DSN=postgres://repomind:repomind@localhost:5432/repomind?sslmode=disable
REPOMIND_POSTGRES_MAX_CONNS=20
REPOMIND_POSTGRES_MIN_CONNS=2

# ---- GitHub App ----
REPOMIND_GITHUB_APP_ID=                # numeric App ID
REPOMIND_GITHUB_INSTALLATION_ID=       # numeric installation id (after org owner approves)
REPOMIND_GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
REPOMIND_GITHUB_BASE_URL=              # empty = github.com; set for GHES
REPOMIND_GITHUB_WEBHOOK_SECRET=        # openssl rand -hex 32
REPOMIND_GITHUB_TIMEOUT=30s
REPOMIND_GITHUB_MAX_RETRIES=3
# Comma-separated allow-list of "owner/name" repos the adapter is
# allowed to query. Required. Anything outside this list returns
# ErrUnauthorizedRepo without touching the network.
REPOMIND_GITHUB_REPOS=acme-org/repo-a,acme-org/repo-b

# Optional path to a YAML file expressing per-repo PR target-branch
# filters (M10). Empty = no branch filtering. See
# configs/repo-policy.example.yaml for the schema.
REPOMIND_GITHUB_REPO_POLICY_PATH=

# ---- Jira (sprint source of truth) ----
REPOMIND_JIRA_BASE_URL=https://acme.atlassian.net
REPOMIND_JIRA_AUTH_MODE=basic          # basic | bearer
REPOMIND_JIRA_EMAIL=ops@acme.com       # required when auth_mode=basic
REPOMIND_JIRA_API_TOKEN=
REPOMIND_JIRA_TIMEOUT=30s
REPOMIND_JIRA_MAX_RETRIES=3
REPOMIND_JIRA_PROJECT_KEY=PROJ         # e.g. SIS
REPOMIND_JIRA_BOARD_ID=0               # numeric agile board id
REPOMIND_JIRA_TEAM_NAME=Team           # sub-team owning this run
# Optional. Defaults to "<TEAM_NAME>_Sprint_" when unset. Used to
# filter sprints on a board shared by multiple sub-teams.
REPOMIND_JIRA_SPRINT_NAME_PREFIX=
# Optional. Jira custom-field id for the "QA Owner" user picker
# (e.g. customfield_10173). When set, the release-notes handler
# populates the QA Owner column from this field. Discover via:
#   GET /rest/api/3/issue/<KEY>?expand=names
# When unset, the QA Owner column is left blank.
REPOMIND_JIRA_QA_OWNER_FIELD_ID=

# ---- Confluence (release-notes destination) ----
REPOMIND_CONFLUENCE_BASE_URL=https://acme.atlassian.net/wiki
REPOMIND_CONFLUENCE_EMAIL=ops@acme.com
REPOMIND_CONFLUENCE_API_TOKEN=
# Two publishing modes, pick one:
#   (a) Legacy master-page mode: set PAGE_ID, leave PARENT_ID + SPACE_KEY blank.
#       Every publish overwrites the same page.
#   (b) Per-sprint mode (preferred): set PARENT_ID + SPACE_KEY (and optionally
#       PAGE_ID as a fallback). RepoMind creates one child page per sprint
#       ("Sprint-<n>") under PARENT_ID and remembers the mapping in the
#       sprint_page table.
REPOMIND_CONFLUENCE_PAGE_ID=           # pre-existing page id (mode a) or fallback (mode b)
REPOMIND_CONFLUENCE_PARENT_ID=         # parent folder / page id for per-sprint child pages
REPOMIND_CONFLUENCE_SPACE_KEY=         # space key that owns PARENT_ID (e.g. SHL360)
REPOMIND_CONFLUENCE_TIMEOUT=30s
REPOMIND_CONFLUENCE_MAX_RETRIES=3      # 429 / 5xx (client) and 409 (publisher) retry budget

# ---- AI provider (OpenAI-compatible) ----
# The same adapter speaks OpenAI, Azure OpenAI, and GitHub Models.
# Pick the deployment, supply BaseURL + API key, done.
#
# Deployment defaults & auth header style:
#   openai         -> https://api.openai.com/v1            (Bearer)
#   github_models  -> https://models.github.ai/inference   (Bearer; key = GitHub PAT)
#   azure_openai   -> https://<resource>.openai.azure.com  (api-key header)
REPOMIND_AI_DEPLOYMENT=openai          # openai | github_models | azure_openai
REPOMIND_AI_API_KEY=
REPOMIND_AI_MODEL=gpt-4o-mini
REPOMIND_AI_BASE_URL=                  # empty -> deployment-default
REPOMIND_AI_TIMEOUT=60s
REPOMIND_AI_MAX_RETRIES=3

# Azure-only: REST API version appended as ?api-version=...
REPOMIND_AI_AZURE_API_VERSION=2024-10-21

# Optional per-role model overrides. Empty -> use REPOMIND_AI_MODEL.
# Useful for routing release notes to a flagship model while keeping
# risk / QA analysis on a cheap fast model.
REPOMIND_AI_RISK_MODEL=
REPOMIND_AI_RELEASE_NOTES_MODEL=
REPOMIND_AI_QA_MODEL=

# ---- Worker (M10 outbox dispatcher) ----
# LISTEN/NOTIFY drives sub-second wake-ups; PollInterval is the
# safety net. BatchSize caps each drain pass. MaxAttempts is the
# total retry budget per event before status flips to 'failed'.
# BaseBackoff seeds exponential backoff (30s -> 1m -> 2m -> 4m -> 8m,
# capped at 1h). HandlerTimeout bounds a single handler invocation.
# ShutdownGrace is how long the dispatcher waits for in-flight
# handlers to finish on ctx cancellation.
REPOMIND_WORKER_POLL_INTERVAL=30s
REPOMIND_WORKER_BATCH_SIZE=32
REPOMIND_WORKER_MAX_ATTEMPTS=5
REPOMIND_WORKER_BASE_BACKOFF=30s
REPOMIND_WORKER_HANDLER_TIMEOUT=2m
REPOMIND_WORKER_SHUTDOWN_GRACE=30s

# ---- Ticker (M10 sprint-state poller) ----
# Set Enabled=false on operator-only instances or during Jira outages.
REPOMIND_TICKER_ENABLED=true
REPOMIND_TICKER_INTERVAL=5m
