# RepoMind — DEVELOPER environment template (SHL site pre-filled).
#
# How to use:
#   1. Copy this file to the repo root as `.env`         (.env is gitignored)
#   2. Fill in the *_API_TOKEN / *_API_KEY / *_SECRET values locally
#   3. `make run-dev`  (loads this file + .env)
#
# !! NEVER commit real tokens. This file must stay free of secrets. !!
# Secrets live ONLY in the gitignored .env at the repo root.

# ---- HTTP server ----
REPOMIND_HTTP_ADDR=:8080
REPOMIND_HTTP_READ_TIMEOUT=15s
REPOMIND_HTTP_WRITE_TIMEOUT=30s
REPOMIND_HTTP_SHUTDOWN_TIMEOUT=15s
# Dev-only placeholder so the operator API stays available locally.
# In production this is injected from a secret store; in CI we leave
# it blank so the operator surface fails closed.
REPOMIND_HTTP_API_KEY=dev-local-operator-key-change-me

# ---- Observability ----
REPOMIND_LOG_LEVEL=debug                 # verbose for dev
REPOMIND_LOG_FORMAT=console              # human-readable in dev
REPOMIND_OTEL_EXPORTER_OTLP_ENDPOINT=    # empty = tracing disabled
REPOMIND_METRICS_ADDR=:9090

# ---- PostgreSQL (matches deploy/docker-compose.yml dev service) ----
REPOMIND_POSTGRES_DSN=postgres://repomind:repomind@localhost:5432/repomind?sslmode=disable
REPOMIND_POSTGRES_MAX_CONNS=10
REPOMIND_POSTGRES_MIN_CONNS=1

# ---- GitHub App (fill in once we set up a dev GitHub App) ----
REPOMIND_GITHUB_APP_ID=4150842
REPOMIND_GITHUB_INSTALLATION_ID=
REPOMIND_GITHUB_PRIVATE_KEY_PATH=./secrets/repomind-shl-india-dev.2026-06-26.private-key.pem
REPOMIND_GITHUB_BASE_URL=
REPOMIND_GITHUB_WEBHOOK_SECRET=          # generate: openssl rand -hex 32

# Comma-separated list of owner/repo pairs the release-notes flow covers.
# All 12 repos belong to the MARVELS squad (Jira project SIS).
# Module 2 will validate this against what the GitHub App is actually
# installed on; mismatch = startup error.
#
# Product groupings (cosmetic — used only when rendering Confluence sections):
#   TDM (7) — Test Data Management
#   MFS (5) — Mobile/Modern File Service (TBC)
REPOMIND_GITHUB_REPOS=SHL-India/TDM-data-management-ui,SHL-India/TDM-tcplus-group-manager,SHL-India/TDM-service.user.validation,SHL-India/TDM-service.user.upload,SHL-India/TDM-lambda-hris-file-validation,SHL-India/TDM-db-scripts,SHL-India/TDM-qa_automation,SHL-India/MFS-mfs-api,SHL-India/MFS-mfs-reports,SHL-India/MFS-reportui,SHL-India/MFS-mfs-admin,SHL-India/MFS-database

# M10 PR target-branch policy. Empty = no filtering.
REPOMIND_GITHUB_REPO_POLICY_PATH=./configs/repo-policy.yaml

# ---- Jira (SHL Cloud, Basic auth with API token) ----
# Sprint source of truth. One project (SIS); our team is "Marvelous"
# (one of four sub-teams on the shared "Marvels Scrum Board"; the
# others — Kang, IronMan, Gladiators — share the board but RepoMind
# ignores them via the sprint-name prefix filter below).
# Tickets look like SIS-9506.
REPOMIND_JIRA_BASE_URL=https://shl.atlassian.net
REPOMIND_JIRA_AUTH_MODE=basic
REPOMIND_JIRA_EMAIL=avichal.srivastava@shl.com
REPOMIND_JIRA_API_TOKEN=                 # create at https://id.atlassian.com/manage-profile/security/api-tokens
REPOMIND_JIRA_TIMEOUT=30s
REPOMIND_JIRA_MAX_RETRIES=3
REPOMIND_JIRA_PROJECT_KEY=SIS
REPOMIND_JIRA_TEAM_NAME=Marvelous
REPOMIND_JIRA_BOARD_ID=187               # "Marvels Scrum Board" (shared)
# Only sprints whose name starts with this prefix belong to our team.
# Default if unset: "<TEAM_NAME>_Sprint_"
REPOMIND_JIRA_SPRINT_NAME_PREFIX=Marvelous_Sprint_
#
# V2 NOTE: Kang / IronMan / Gladiators each have their own sprint
# prefix AND their own Confluence parent folder. When we generalise,
# these scalar TEAM/PREFIX/PARENT_ID/SPACE_KEY values become a list
# of tuples (team, sprintPrefix, confluenceParentId, confluenceSpaceKey)
# and the sprint worker fans out one job per team per active sprint.
# V1 ships Marvelous only.

# ---- Confluence (SHL Cloud) ----
# Reuses the same Atlassian API token as Jira. The /wiki suffix is required.
# Per-sprint mode is enabled: each active sprint gets its own child page
# ("Sprint-<n>") under the "AI Release Notes" folder in space SHL360.
# PAGE_ID (345833780) is the legacy master page — kept as a fallback for
# environments where PARENT_ID / SPACE_KEY are blank.
#   Parent: https://shl.atlassian.net/wiki/spaces/SHL360/pages/357991802
REPOMIND_CONFLUENCE_BASE_URL=https://shl.atlassian.net/wiki
REPOMIND_CONFLUENCE_EMAIL=avichal.srivastava@shl.com
REPOMIND_CONFLUENCE_API_TOKEN=
REPOMIND_CONFLUENCE_PAGE_ID=345833780
REPOMIND_CONFLUENCE_PARENT_ID=357991802
REPOMIND_CONFLUENCE_SPACE_KEY=SHL360
REPOMIND_CONFLUENCE_TIMEOUT=30s
REPOMIND_CONFLUENCE_MAX_RETRIES=3

# ---- AI (GitHub Models — dev default; free, uses a GitHub PAT) ----
# The OpenAI-compatible adapter speaks GitHub Models, Azure OpenAI,
# and OpenAI direct. For local dev we use GitHub Models so devs can
# work without a paid key — just a fine-grained GitHub PAT with
# models:read scope (https://github.com/settings/personal-access-tokens).
#
# For production this flips to:
#   REPOMIND_AI_DEPLOYMENT=azure_openai
#   REPOMIND_AI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   REPOMIND_AI_API_KEY=<azure key>
#   REPOMIND_AI_AZURE_API_VERSION=2024-10-21
REPOMIND_AI_DEPLOYMENT=github_models
REPOMIND_AI_API_KEY=                     # GitHub PAT with models:read
REPOMIND_AI_MODEL=gpt-4o-mini
REPOMIND_AI_BASE_URL=                    # empty -> https://models.github.ai/inference
REPOMIND_AI_TIMEOUT=60s
REPOMIND_AI_MAX_RETRIES=3

# Optional per-role overrides — leave empty in dev.
REPOMIND_AI_RISK_MODEL=
REPOMIND_AI_RELEASE_NOTES_MODEL=
REPOMIND_AI_QA_MODEL=

# ---- Worker (M10 outbox dispatcher) ----
REPOMIND_WORKER_POLL_INTERVAL=30s
REPOMIND_WORKER_BATCH_SIZE=32
REPOMIND_WORKER_MAX_ATTEMPTS=5
REPOMIND_WORKER_BASE_BACKOFF=30s
REPOMIND_WORKER_HANDLER_TIMEOUT=2m
REPOMIND_WORKER_SHUTDOWN_GRACE=30s

# ---- Ticker (M10 sprint-state poller) ----
REPOMIND_TICKER_ENABLED=true
REPOMIND_TICKER_INTERVAL=5m
